[Unit]
Description=Deepgram push-to-talk dictation
After=pipewire-pulse.socket

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=ZDOTDIR=%h/.config/zsh
# Wrapper sources ~/.config/zsh/config/secrets.zsh for DEEPGRAM_API_KEY.
ExecStart=%h/w/p/deepgram-dictate/bin/deepgram-dictate-service
Restart=on-failure
RestartSec=2
# Exit 78 means missing config, so restarting will not help.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
